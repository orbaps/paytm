# Ignore all backend directories - these are deployed to Railway
/phase1/**
/phase2/**
/phase3/**
/phase4/backend/**

# Ignore data and documentation directories
/data/**
/Docs/**
/scripts/**
/schemas/**
/reports/**
/src/**
/notebooks/**
/outputs/**

# Ignore Python files everywhere
*.py
*.pyc
*.pyo
*.pyd
*.pyw
*.pyx
*.egg-info/**
__pycache__/**
.pytest_cache/**

# Ignore Docker files (backend only)
docker-compose.yml
Dockerfile

# Ignore git and other config files
.git/**
.gitignore
.github/**
.gitattributes

# Ignore environment files
.env
.env.local
.env.*.local
.env.example

# Note: phase4/frontend is NOT ignored and will be built

