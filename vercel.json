{
  "buildCommand": "cd phase4/frontend && npm install && npm run build",
  "outputDirectory": "phase4/frontend/dist",
  "installCommand": "cd phase4/frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  }
}
