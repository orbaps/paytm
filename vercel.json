{
  "buildCommand": "cd phase4/frontend && npm run build",
  "outputDirectory": "phase4/frontend/dist",
  "env": {
    "VITE_API_URL": "@vite_api_url"
  },
  "envPrefix": "VITE_",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "regions": ["iad1"]
}
